# Auto detect text files and perform LF normalization
* text=auto

# File types that should always use LF (Unix) line endings
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
gradlew text eol=lf

# File types that should always use CRLF (Windows) line endings
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Denote files that are truly binary and should not be modified
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.keystore binary
*.bin binary
*.apk binary
